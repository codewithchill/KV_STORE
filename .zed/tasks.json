[
    {
        "label": "Run",
        "hide": "never",
        "save": "current",
        "reveal": "always",
        "reveal_target": "center",
        "show_summary": true,
        "use_new_terminal": false,
        "cwd": "$ZED_WORKTREE_ROOT",
        "shell": {
            "program": "powershell"
        },
        "command": "clear; if ($?) {make clean}; if ($?) {make OPT=-O2 -j8}; if ($?) {./out/main.exe}; if ($?) {make clean}"
    },
    {
        "label": "Clean",
        "reveal_target": "dock",
        "show_summary": true,
        "use_new_terminal": false,
        "cwd": "$ZED_WORKTREE_ROOT",
        "shell": {
            "program": "powershell"
        },
        "command": "make clean"
    },
]
