[
    {
        "label": "CLANG - Debug native binary",
        "build": {
            "command": "make",
            "args": ["-j8", "all", "OPT=-O0", "SANITIZE_ADDR=\"\""],
            "cwd": "$ZED_WORKTREE_ROOT"
        },
        "program": "$ZED_WORKTREE_ROOT/out/main.exe",
        "request": "launch",
        "adapter": "CodeLLDB"
    },
    {
        "label": "GCC - Debug native binary",
        "build": {
            "command": "make",
            "args": ["-j8", "all", "OPT=-O0", "SANITIZE_ADDR=", "CC=gcc"],
            "cwd": "$ZED_WORKTREE_ROOT"
        },
        "program": "$ZED_WORKTREE_ROOT/out/main",
        "request": "launch",
        "adapter": "GDB"
    }
]
